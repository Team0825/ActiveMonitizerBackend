datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String  @id @default(uuid())
  role         String
  username     String  @unique
  name         String?
  passwordHash String

  regNumber  String? @unique
  rollNumber String?
  mobile     String?
  email      String? @unique
  classId    String?

  isActive Boolean @default(true)

  createdById  String?
  createdBy    User?   @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers User[]  @relation("CreatedUsers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionsAsTeacher ClassSession[] @relation("TeacherSessions")

  participations SessionParticipant[]

  attendanceRecords Attendance[] @relation("StudentAttendance")
  attendanceReviews Attendance[] @relation("AttendanceReviewer")

  accessRequestsMade    SpecialAccessRequest[] @relation("RequestingStudent")
  accessRequestsHandled SpecialAccessRequest[] @relation("ApprovingTeacher")

  messagesSent     Message[] @relation("MessageSender")
  messagesReceived Message[] @relation("MessageRecipient")

  @@index([role])
  @@index([classId])
  @@index([rollNumber])
}

model ClassSession {
  id String @id @default(uuid())

  sessionCode String @unique
  classTitle  String

  teacherId String
  teacher   User   @relation("TeacherSessions", fields: [teacherId], references: [id])

  durationMinutes   Int
  joinWindowMinutes Int @default(15)

  allowedSites String @default("[]")
  blockedSites String @default("[]")

  status      String @default("ACTIVE")
  sessionMode String @default("LAB")

  allowOffline Boolean @default(true)

  restrictExistingFiles    Boolean @default(false)
  restrictUnauthorizedApps Boolean @default(false)

  freezeOnEnd Boolean @default(true)

  warningMinutes Int @default(5)

  instructions String?

  questionMode String @default("COMMON")

  createdAt DateTime @default(now())
  endsAt    DateTime

  participants      SessionParticipant[]
  attendanceRecords Attendance[]
  accessRequests    SpecialAccessRequest[]
  messages          Message[]

  @@index([status])
  @@index([createdAt])
  @@index([teacherId])
}

model Pc {
  id       String @id @default(uuid())
  hostname String @unique

  displayName String?
  labName     String?

  status         String @default("OFFLINE")
  healthStatus   String @default("UNKNOWN")
  internetStatus String @default("OFFLINE")

  latencyMs Int?

  osName    String?
  osVersion String?

  cpuName           String?
  totalMemoryMb     Int?
  availableMemoryMb Int?
  totalDiskMb       Int?
  availableDiskMb   Int?

  agentVersion  String?
  clientVersion String?

  updateStatus String @default("UPDATED")

  currentSessionId String?
  currentStudentId String?

  lastSeen        DateTime?
  lastHealthCheck DateTime?
  lastSyncAt      DateTime?

  registeredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  healthReports     PcHealthReport[]
  softwareInventory PcSoftware[]

  @@index([labName])
  @@index([status])
  @@index([healthStatus])
  @@index([internetStatus])
  @@index([updateStatus])
  @@index([currentSessionId])
  @@index([currentStudentId])
  @@index([lastSeen])
}

model PcHealthReport {
  id String @id @default(uuid())

  pcId String
  pc   Pc     @relation(fields: [pcId], references: [id], onDelete: Cascade)

  healthStatus   String
  internetStatus String

  latencyMs Int?

  cpuUsagePercent    Float?
  memoryUsagePercent Float?
  diskUsagePercent   Float?

  availableMemoryMb Int?
  availableDiskMb   Int?

  issueCode    String?
  issueMessage String?

  reportedAt DateTime @default(now())

  @@index([pcId])
  @@index([healthStatus])
  @@index([internetStatus])
  @@index([reportedAt])
}

model PcSoftware {
  id String @id @default(uuid())

  pcId String
  pc   Pc     @relation(fields: [pcId], references: [id], onDelete: Cascade)

  softwareName String

  installedVersion String?
  requiredVersion  String?

  status String @default("INSTALLED")

  detectedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([pcId, softwareName])
  @@index([pcId])
  @@index([softwareName])
  @@index([status])
}

model SessionParticipant {
  id String @id @default(uuid())

  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id])

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  pcHostname String?

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  approvedLate Boolean @default(false)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([pcHostname])
}

model Attendance {
  id String @id @default(uuid())

  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id])

  studentId String
  student   User   @relation("StudentAttendance", fields: [studentId], references: [id])

  presentSeconds  Int
  requiredSeconds Int

  isPresent Boolean @default(false)

  attendancePercent Float @default(0)
  activityPercent   Float @default(0)
  overallPercent    Float @default(0)

  warningCount Int @default(0)

  reviewStatus String @default("PENDING")

  reviewedById String?
  reviewedBy   User?   @relation("AttendanceReviewer", fields: [reviewedById], references: [id])

  autoReviewAt DateTime?
  reviewedAt   DateTime?

  autoReviewed Boolean @default(false)

  reviewReason String?
  computedAt   DateTime?

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([reviewStatus])
  @@index([autoReviewAt])
  @@index([reviewedById])
}

model SpecialAccessRequest {
  id String @id @default(uuid())

  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id])

  studentId String
  student   User   @relation("RequestingStudent", fields: [studentId], references: [id])

  status String @default("PENDING")

  requestedAt DateTime @default(now())

  handledById String?
  handledBy   User?   @relation("ApprovingTeacher", fields: [handledById], references: [id])

  handledAt DateTime?

  @@index([sessionId, status])
  @@index([studentId])
}

model Message {
  id String @id @default(uuid())

  sessionId String?
  session   ClassSession? @relation(fields: [sessionId], references: [id])

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])

  recipientId String?
  recipient   User?   @relation("MessageRecipient", fields: [recipientId], references: [id])

  recipientType String @default("USER")

  classId String?

  messageType String @default("MESSAGE")

  subject String?
  body    String

  allowReply Boolean @default(false)

  parentMessageId String?
  parentMessage   Message?  @relation("MessageReplies", fields: [parentMessageId], references: [id])
  replies         Message[] @relation("MessageReplies")

  sentAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments MessageAttachment[]

  @@index([sessionId])
  @@index([senderId])
  @@index([recipientId])
  @@index([recipientType])
  @@index([classId])
  @@index([messageType])
  @@index([parentMessageId])
  @@index([sentAt])
}

model MessageAttachment {
  id String @id @default(uuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String

  mimeType String?
  fileSize Int?

  createdAt DateTime @default(now())

  @@index([messageId])
}

model AuditLog {
  id String @id @default(uuid())

  actorId String
  action  String

  targetPc   String?
  targetUser String?

  metadata String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model AgentTheme {
  id String @id @default(uuid())

  themeName String  @unique
  isActive  Boolean @default(false)

  // Colors
  mainBubbleBgColor   String @default("#1E293B")
  secondaryPanelColor String @default("#0F172A")
  borderColor         String @default("#334155")
  accentColor         String @default("#22C55E")
  textColor           String @default("#FFFFFF")
  mutedTextColor      String @default("#94A3B8")
  buttonColor         String @default("#334155")
  buttonTextColor     String @default("#FFFFFF")

  // Appearance
  progressBarAppearance String @default("DEFAULT")
  opacity               Float  @default(1.0)
  cornerRadius          Int    @default(20)
  baseFontSize          Int    @default(12)

  // Labels
  sessionTitleLabel        String @default("Active Session")
  timerLabel               String @default("TIME REMAINING")
  pcActivityLabel          String @default("PC ACTIVITY")
  agentStatusText          String @default("Agent: Running")
  networkStatusText        String @default("Network: Healthy")
  minimizeButtonLabel      String @default("MINIMIZE")
  closeButtonLabel         String @default("CLOSE")
  sendReplyButtonLabel     String @default("SEND REPLY")
  defaultInformationalText String @default("Session is active. Keep this Activity Monitor running.")

  // Branding
  organizationLogoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}
