datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String  @id @default(uuid())
  role         String
  isSuperAdmin Boolean @default(false)
  username     String  @unique
  name         String?
  passwordHash String

  regNumber  String? @unique
  rollNumber String?
  mobile     String?
  email      String? @unique
  classId    String?

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])

  lastLoginAt   DateTime?
  lastActiveAt  DateTime?

  isActive Boolean @default(true)

  createdById  String?
  createdBy    User?   @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers User[]  @relation("CreatedUsers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionsAsTeacher ClassSession[] @relation("TeacherSessions")

  participations SessionParticipant[]

  attendanceRecords Attendance[] @relation("StudentAttendance")
  attendanceReviews Attendance[] @relation("AttendanceReviewer")

  accessRequestsMade    SpecialAccessRequest[] @relation("RequestingStudent")
  accessRequestsHandled SpecialAccessRequest[] @relation("ApprovingTeacher")

  messagesSent     Message[] @relation("MessageSender")
  messagesReceived Message[] @relation("MessageRecipient")

  questionPapers QuestionPaper[] @relation("QuestionPaperCreator")
  examsCreated   Exam[]          @relation("ExamCreator")
  examAttempts   ExamAttempt[]   @relation("StudentExamAttempts")
  examResults    ExamResult[]    @relation("StudentExamResults")

  @@index([role])
  @@index([classId])
  @@index([rollNumber])
  @@index([institutionId])
  @@index([departmentId])
}

model ClassSession {
  allowInternet    Boolean @default(true)
  allowClipboard   Boolean @default(true)
  allowUsb         Boolean @default(true)
  allowTaskManager Boolean @default(true)
  allowAltTab      Boolean @default(true)
  allowWindowsKey  Boolean @default(true)
  allowPrintScreen Boolean @default(true)

  freezeOnEnd Boolean @default(false)

  warningMinutes Int @default(5)

  screenshotInterval Int?

  instructions String?

  startupUrl String?

  policyVersion Int @default(1)

  allowedWebsites AllowedWebsite[]
  blockedWebsites BlockedWebsite[]

  allowedApplications AllowedApplication[]
  blockedApplications BlockedApplication[]

  id String @id @default(uuid())

  sessionCode String  @unique
  cbtCode     String? @unique
  classTitle  String

  teacherId String
  teacher   User   @relation("TeacherSessions", fields: [teacherId], references: [id])

  durationMinutes   Int
  joinWindowMinutes Int @default(15)

  status      String @default("ACTIVE")
  sessionMode String @default("LAB")

  allowOffline Boolean @default(true)
  connectivityMode String @default("HYBRID")
  websiteAccessMode String @default("NORMAL")

  restrictExistingFiles    Boolean @default(false)
  restrictUnauthorizedApps Boolean @default(false)

  activityMonitoring     Boolean @default(true)
  activityUpdateInterval Int     @default(2)
  activitySensitivity    String  @default("NORMAL")
  idleThresholdSeconds   Int     @default(10)
  violationSensitivity   String  @default("NORMAL")

  questionMode String @default("COMMON")

  createdAt DateTime @default(now())
  endsAt    DateTime

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  participants      SessionParticipant[]
  attendanceRecords Attendance[]
  accessRequests    SpecialAccessRequest[]
  messages          Message[]
  SessionPolicyLog  SessionPolicyLog[]
  exams             Exam[]

  @@index([status])
  @@index([createdAt])
  @@index([teacherId])
  @@index([cbtCode])
  @@index([institutionId])
}

model Pc {
  id       String @id @default(uuid())
  hostname String @unique

  displayName String?
  labName     String?

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])

  status         String @default("OFFLINE")
  healthStatus   String @default("UNKNOWN")
  internetStatus String @default("OFFLINE")

  latencyMs Int?

  osArchitecture String?
  osName         String?
  osVersion      String?

    cpuName           String?

  gpuName           String?
  gpuDriverVersion  String?

  totalMemoryMb     Int?
  availableMemoryMb Int?

  totalDiskMb       Int?
  availableDiskMb   Int?

  uptimeSeconds     Int?
  restartRequired   Boolean?
  firewallEnabled   Boolean?
  antivirusEnabled  Boolean?

  agentVersion  String?
  clientVersion String?

  updateStatus String @default("UPDATED")

  currentSessionId String?
  currentStudentId String?

  lastSeen        DateTime?
  lastHealthCheck DateTime?
  lastSyncAt      DateTime?

  registeredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  healthReports     PcHealthReport[]
  softwareInventory PcSoftware[]

  @@index([labName])
  @@index([status])
  @@index([healthStatus])
  @@index([internetStatus])
  @@index([updateStatus])
  @@index([currentSessionId])
  @@index([currentStudentId])
  @@index([lastSeen])
  @@index([institutionId])
}

model PcHealthReport {
   agentVersion        String?
  osName              String?
  osVersion           String?
  osArchitecture      String?
  processArchitecture String?

  processorCount Int?

  gpuName          String?
  gpuDriverVersion String?

  uptimeSeconds    Int?
  restartRequired  Boolean?
  firewallEnabled  Boolean?
  antivirusEnabled Boolean?

  dotNetVersion String?

  ramUsage Float?

  totalMemoryMb Int?

  freeMemoryMb Int?

  diskUsage Float?

  totalDiskGb Int?

  freeDiskGb Int?

  internetConnected Boolean?

  lastSystemReport DateTime?
  id               String    @id @default(uuid())

  pcId String
  pc   Pc     @relation(fields: [pcId], references: [id], onDelete: Cascade)

  healthStatus   String
  internetStatus String

  latencyMs Int?

  cpuUsagePercent    Float?
  memoryUsagePercent Float?
  diskUsagePercent   Float?

  availableMemoryMb Int?
  availableDiskMb   Int?

  issueCode    String?
  issueMessage String?

  reportedAt DateTime @default(now())

  @@index([pcId])
  @@index([healthStatus])
  @@index([internetStatus])
  @@index([reportedAt])
}

model PcSoftware {
  id String @id @default(uuid())

  pcId String
  pc   Pc     @relation(fields: [pcId], references: [id], onDelete: Cascade)

  softwareName String

  installedVersion String?
  requiredVersion  String?

  status String @default("INSTALLED")

  detectedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([pcId, softwareName])
  @@index([pcId])
  @@index([softwareName])
  @@index([status])
}

model SessionParticipant {
  id String @id @default(uuid())

  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id])

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  pcHostname String?

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  approvedLate Boolean @default(false)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([pcHostname])
}

model Attendance {
  id String @id @default(uuid())

  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id])

  studentId String
  student   User   @relation("StudentAttendance", fields: [studentId], references: [id])

  presentSeconds  Int
  requiredSeconds Int

  isPresent Boolean @default(false)

  attendancePercent Float @default(0)
  activityPercent   Float @default(0)
  overallPercent    Float @default(0)

  warningCount Int @default(0)

  reviewStatus String @default("PENDING")

  reviewedById String?
  reviewedBy   User?   @relation("AttendanceReviewer", fields: [reviewedById], references: [id])

  autoReviewAt DateTime?
  reviewedAt   DateTime?

  autoReviewed Boolean @default(false)

  reviewReason String?
  computedAt   DateTime?

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([reviewStatus])
  @@index([autoReviewAt])
  @@index([reviewedById])
}

model SpecialAccessRequest {
  id String @id @default(uuid())

  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id])

  studentId String
  student   User   @relation("RequestingStudent", fields: [studentId], references: [id])

  status String @default("PENDING")

  requestedAt DateTime @default(now())

  handledById String?
  handledBy   User?   @relation("ApprovingTeacher", fields: [handledById], references: [id])

  handledAt DateTime?

  @@index([sessionId, status])
  @@index([studentId])
}

model Message {
  id String @id @default(uuid())

  sessionId String?
  session   ClassSession? @relation(fields: [sessionId], references: [id])

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])

  recipientId String?
  recipient   User?   @relation("MessageRecipient", fields: [recipientId], references: [id])

  recipientType String @default("USER")

  classId String?

  messageType String @default("MESSAGE")

  subject String?
  body    String

  allowReply Boolean @default(false)

  parentMessageId String?
  parentMessage   Message?  @relation("MessageReplies", fields: [parentMessageId], references: [id])
  replies         Message[] @relation("MessageReplies")

  sentAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments MessageAttachment[]

  @@index([sessionId])
  @@index([senderId])
  @@index([recipientId])
  @@index([recipientType])
  @@index([classId])
  @@index([messageType])
  @@index([parentMessageId])
  @@index([sentAt])
}

model MessageAttachment {
  id String @id @default(uuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String

  mimeType String?
  fileSize Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([messageId])
}

model AllowedWebsite {
  id        String       @id @default(cuid())
  domain    String
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}

model BlockedWebsite {
  id        String       @id @default(cuid())
  domain    String
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}

model AllowedApplication {
  id          String       @id @default(cuid())
  processName String
  sessionId   String
  session     ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}

model BlockedApplication {
  id          String       @id @default(cuid())
  processName String
  sessionId   String
  session     ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}

model AuditLog {
  id String @id @default(uuid())

  actorId String
  action  String

  targetPc   String?
  targetUser String?

  metadata String?

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model SessionPolicyLog {
  id String @id @default(uuid())

  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  version Int

  changedBy String

  description String

  createdAt DateTime @default(now())

  @@index([sessionId])
}

model AgentTheme {
  id String @id @default(uuid())

  themeName String  @unique
  isActive  Boolean @default(false)

  // Colors
  mainBubbleBgColor   String @default("#1E293B")
  secondaryPanelColor String @default("#0F172A")
  borderColor         String @default("#334155")
  accentColor         String @default("#22C55E")
  textColor           String @default("#FFFFFF")
  mutedTextColor      String @default("#94A3B8")
  buttonColor         String @default("#334155")
  buttonTextColor     String @default("#FFFFFF")

  // Appearance
  progressBarAppearance String @default("DEFAULT")
  opacity               Float  @default(1.0)
  cornerRadius          Int    @default(20)
  baseFontSize          Int    @default(12)

  // Labels
  sessionTitleLabel        String @default("Active Session")
  timerLabel               String @default("TIME REMAINING")
  pcActivityLabel          String @default("PC ACTIVITY")
  agentStatusText          String @default("Agent: Running")
  networkStatusText        String @default("Network: Healthy")
  minimizeButtonLabel      String @default("MINIMIZE")
  closeButtonLabel         String @default("CLOSE")
  sendReplyButtonLabel     String @default("SEND REPLY")
  defaultInformationalText String @default("Session is active. Keep this Activity Monitor running.")

  // Branding
  organizationLogoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model QuestionPaper {
  id           String   @id @default(uuid())
  title        String
  subject      String
  description  String?
  totalMarks   Float    @default(100.0)
  passingMarks Float    @default(40.0)

  createdById  String
  createdBy    User     @relation("QuestionPaperCreator", fields: [createdById], references: [id])

  questions    Question[]
  exams        Exam[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdById])
  @@index([subject])
}

model Question {
  id              String         @id @default(uuid())
  questionPaperId String
  questionPaper   QuestionPaper  @relation(fields: [questionPaperId], references: [id], onDelete: Cascade)

  questionText    String
  questionType    String         @default("MCQ")
  section         String         @default("General")
  orderIndex      Int            @default(0)
  options         Json
  correctAnswer   String
  marks           Float          @default(1.0)
  negativeMarks   Float          @default(0.0)
  explanation     String?
  imageUrl        String?

  answers         ExamAnswer[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([questionPaperId])
  @@index([orderIndex])
}

model Exam {
  id                  String         @id @default(uuid())
  title               String
  subject             String
  description         String?
  instructions        String?

  cbtCode             String?        @unique
  reviewPeriodHours   Int            @default(24)
  canGenerateResultAt DateTime?
  isPcConfigLocked    Boolean        @default(false)

  questionPaperId     String
  questionPaper       QuestionPaper  @relation(fields: [questionPaperId], references: [id])

  sessionId           String?
  session             ClassSession?  @relation(fields: [sessionId], references: [id])

  createdById         String
  createdBy           User           @relation("ExamCreator", fields: [createdById], references: [id])

  durationMinutes     Int            @default(60)
  totalMarks          Float          @default(100.0)
  passingMarks        Float          @default(40.0)

  shuffleQuestions    Boolean        @default(false)
  shuffleOptions      Boolean        @default(false)
  allowReview         Boolean        @default(true)
  autoSubmitOnTimeUp  Boolean        @default(true)

  status              String         @default("DRAFT")
  resultVisibility    String         @default("AFTER_PUBLISH")
  resultPublished     Boolean        @default(false)

  startsAt            DateTime?
  endsAt              DateTime?

  institutionId       String?
  institution         Institution?   @relation(fields: [institutionId], references: [id])

  attempts            ExamAttempt[]
  results             ExamResult[]
  pcRegistrations     CbtPcRegistration[]

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([questionPaperId])
  @@index([sessionId])
  @@index([createdById])
  @@index([status])
  @@index([cbtCode])
  @@index([institutionId])
}

model ExamAttempt {
  id                   String       @id @default(uuid())
  examId               String
  exam                 Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)

  studentId            String
  student              User         @relation("StudentExamAttempts", fields: [studentId], references: [id])

  sessionId            String?
  pcHostname           String?

  status               String       @default("IN_PROGRESS")
  startedAt            DateTime     @default(now())
  submittedAt          DateTime?
  clientIp             String?
  timeRemainingSeconds Int?

  answers              ExamAnswer[]
  result               ExamResult?

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([status])
}

model ExamAnswer {
  id                String       @id @default(uuid())
  attemptId         String
  attempt           ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId        String
  question          Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOption    String?
  answerText        String?
  isMarkedForReview Boolean      @default(false)

  savedAt           DateTime     @default(now())
  isEvaluated       Boolean      @default(false)
  isCorrect         Boolean?
  marksObtained     Float        @default(0.0)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model ExamResult {
  id              String       @id @default(uuid())
  examId          String
  exam            Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)

  attemptId       String       @unique
  attempt         ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  studentId       String
  student         User         @relation("StudentExamResults", fields: [studentId], references: [id])

  sessionId       String?

  totalQuestions  Int
  attemptedCount  Int
  correctCount    Int
  wrongCount      Int
  unansweredCount Int

  totalMarks      Float
  obtainedMarks   Float
  percentage      Float
  grade           String?
  isPassed        Boolean

  status          String       @default("EVALUATED")
  evaluatedAt     DateTime     @default(now())
  publishedAt     DateTime?

  corrections     ResultCorrectionAudit[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([status])
}

model CbtPcRegistration {
  id           String       @id @default(uuid())
  examId       String?
  exam         Exam?        @relation(fields: [examId], references: [id], onDelete: Cascade)
  sessionId    String?
  cbtCode      String
  pcHostname   String
  pcId         String?
  status       String       @default("REGISTERED")
  registeredAt DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([cbtCode, pcHostname])
  @@index([cbtCode])
  @@index([sessionId])
  @@index([examId])
  @@index([pcHostname])
}

model AuthoritySetting {
  id           String   @id @default(uuid())
  key          String   @unique @default("AUTHORITY_PASSWORD")
  passwordHash String
  updatedById  String?
  updatedAt    DateTime @updatedAt
}

model ResultCorrectionAudit {
  id            String      @id @default(uuid())
  examResultId  String
  examResult    ExamResult  @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  examId        String
  studentId     String
  adminId       String
  previousMarks Float
  newMarks      Float
  previousGrade String?
  newGrade      String?
  reason        String?
  correctedAt   DateTime    @default(now())

  @@index([examResultId])
  @@index([examId])
  @@index([studentId])
}

model CbtRegistrationCode {
  id          String    @id @default(uuid())
  code        String    @unique
  createdById String
  expiresAt   DateTime
  isUsed      Boolean   @default(false)
  usedByPc    String?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([code])
  @@index([isUsed])
}

model Institution {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  board       String?
  location    String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  departments Department[]
  licenses    License[]
  sessions    ClassSession[]
  pcs         Pc[]
  exams       Exam[]
  themes      AppTheme[]

  @@index([code])
  @@index([isActive])
}

model Department {
  id            String      @id @default(uuid())
  name          String
  code          String
  description   String?
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  students      User[]

  @@unique([institutionId, name])
  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([isActive])
}

model License {
  id                 String      @id @default(uuid())
  licenseNumber      String      @unique
  activationKey      String      @unique
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  machineFingerprint String?
  machineName        String?
  licenseType        String      @default("PRO") // PRO, ENTERPRISE, STANDARD
  status             String      @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED, INACTIVE
  isActivated        Boolean     @default(false)
  maxPcs             Int         @default(100)
  activatedAt        DateTime?
  expiresAt          DateTime?
  lastValidatedAt    DateTime?
  serverSignature    String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([licenseNumber])
  @@index([activationKey])
  @@index([institutionId])
  @@index([machineFingerprint])
  @@index([status])
}

model AppTheme {
  id                  String       @id @default(uuid())
  targetInterface     String       @default("GLOBAL") // GLOBAL, ADMIN, TEACHER, AGENT, ANDROID
  themeName           String
  themeMode           String       @default("AUTO") // LIGHT, DARK, AUTO, CUSTOM
  palette             String       @default("DEFAULT")
  primaryColor        String       @default("#2563EB")
  secondaryColor      String       @default("#0F172A")
  accentColor         String       @default("#22C55E")
  backgroundColor     String       @default("#0F172A")
  cardBackground      String       @default("#1E293B")
  textColor           String       @default("#FFFFFF")
  mutedTextColor      String       @default("#94A3B8")
  buttonColor         String       @default("#2563EB")
  buttonTextColor     String       @default("#FFFFFF")
  headerColor         String       @default("#0F172A")
  sidebarColor        String       @default("#0F172A")
  borderColor         String       @default("#334155")
  statusSuccess       String       @default("#22C55E")
  statusWarning       String       @default("#F59E0B")
  statusDanger        String       @default("#EF4444")
  statusInfo          String       @default("#3B82F6")
  logoUrl             String?
  institutionName     String?
  institutionBoard    String?
  institutionLocation String?
  institutionId       String?
  institution         Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([targetInterface])
  @@index([isActive])
}



